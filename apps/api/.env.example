# Copie para .env (não versionado). Ver README.md.

DATA_ROOT=data
PIPELINE_PATH=../../pipeline
MAX_UPLOAD_MB=2048
MAX_VIDEO_DURATION_S=1200
MIN_IMAGES=20

# Auth — produção: JWT HS256 do Supabase. Dev local sem conta:
# 1 só em localhost. Produção (L4) deve ficar 0 — a UI remota não envia mais dev-bypass.
DEV_AUTH_BYPASS=0
# Login local sem Supabase (conta única). Exige SUPABASE_JWT_SECRET para
# assinar a sessão e DEV_AUTH_BYPASS=0 para o token ser exigido de fato.
# LOCAL_AUTH_USER=caio
# LOCAL_AUTH_PASSWORD=trocar-por-senha-forte
# CORS: lista CSV ou JSON. Use * só em avaliação (desliga credentials).
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://vm.groupabz.com:2222,http://localhost:2222
# Um único entry (UI+API): pasta do `pnpm --filter @gs/web build`
# SERVE_WEB_DIR=../../apps/web/dist
SUPABASE_JWT_SECRET=
SUPABASE_URL=
SUPABASE_JWKS_URL=

TOOL_FFMPEG=ffmpeg
TOOL_FFPROBE=ffprobe
# Binário do usuário (nunca apt/compile pelo app). Ex. Linux:
# TOOL_COLMAP=/home/caio/colmap/build/src/colmap/exe/colmap
TOOL_COLMAP=colmap
# Interpretador do .venv (torch/gsplat/tyro). Nunca /usr/bin/python3 — o
# binário do venv costuma ser symlink para o Python do sistema e só o
# caminho .venv/bin/python carrega site-packages.
TOOL_PYTHON=.venv/bin/python
TOOL_SIMPLE_TRAINER=simple_trainer.py
TOOL_SPLAT_TRANSFORM=splat-transform

# L4 24GB: qualidade — data_factor 2 + SH 3 + 30000 steps + scale_reg.
TRAIN_MAX_STEPS=30000
TRAIN_DATA_FACTOR=2
TRAIN_SH_DEGREE=3
COLMAP_MIN_REGISTERED_COUNT=20
COLMAP_MIN_REGISTERED_RATIO=0.70
COLMAP_MAX_EXHAUSTIVE_IMAGES=220
# SIFT em GPU (1) com fallback automático para CPU se feature_extractor/matcher
# falharem (servidor headless sem contexto OpenGL). 0 força CPU sempre.
COLMAP_USE_GPU=1
