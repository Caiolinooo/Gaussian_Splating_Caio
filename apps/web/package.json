{
  "name": "@gs/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --force",
    "lint": "eslint . --config ../../eslint.config.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:math": "vitest run src/features/calibration/math"
  },
  "dependencies": {
    "@gs/overlays": "workspace:*",
    "@gs/units": "workspace:*",
    "@gs/viewer": "workspace:*",
    "@supabase/supabase-js": "^2.57.4",
    "big.js": "^7.0.1",
    "immer": "^10.1.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.4",
    "three": "^0.180.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/big.js": "^6.2.2",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "~5.9.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  },
  "vitest": {
    "environment": "node",
    "include": [
      "src/features/**/*.test.ts",
      "src/lib/**/*.test.ts"
    ]
  }
}
