# Só no `pnpm dev` (Vite :5173). Deixe vazio no build servido pela API
# (`SERVE_WEB_DIR` em :2222) — a UI usa a origem da página.
# VITE_API_URL=http://localhost:8000

# Supabase Auth (e-mail/senha + OAuth). Deixe vazio e use o bypass em dev.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 1 = libera o app sem Supabase e envia Bearer dev-bypass para a API.
VITE_DEV_AUTH_BYPASS=1
