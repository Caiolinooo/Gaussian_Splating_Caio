# Só no `pnpm dev` (Vite :5173). Deixe vazio: a UI usa a origem e o
# proxy em vite.config.ts encaminha para o servidor (padrão
# http://vm.groupabz.com:2222, override GS_API_PROXY).
# VITE_API_URL=http://vm.groupabz.com:2222

# Supabase Auth (e-mail/senha + OAuth). Deixe vazio e use o bypass em dev.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Só no `pnpm dev` em localhost. Nunca bakear 1 no dist do servidor:
# a UI remota ignora o flag fora de loopback, e `.env.production` força 0.
# VITE_DEV_AUTH_BYPASS=1
