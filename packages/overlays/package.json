{
  "name": "@gs/overlays",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./validate": {
      "types": "./src/validate.ts",
      "default": "./src/validate.ts"
    },
    "./serialize": {
      "types": "./src/serialize.ts",
      "default": "./src/serialize.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --config ../../eslint.config.mjs"
  },
  "dependencies": {
    "@gs/units": "workspace:*",
    "three": "^0.180.0"
  },
  "peerDependencies": {
    "three": ">=0.170.0",
    "zustand": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "zustand": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
